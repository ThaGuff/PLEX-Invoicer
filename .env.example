# ─── PLEX Invoicer — Environment Variables ────────────────────────
# Copy these to Railway → Service → Variables

# ── AI Scraping ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...           # GPT-4o for website scraping

# ── Database ─────────────────────────────────────────────────────
# If using Railway SQLite (default):
DB_PATH=/app/data/plex.db       # auto-created on first boot

# ── Authentication (Supabase) ─────────────────────────────────────
# Create a free project at supabase.com → Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...     # service_role key (server only)
# Also add these as VITE_ vars for the frontend build:
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...  # anon/public key (safe to expose)

# ── Stripe (Payments) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...   # or sk_test_ for testing
STRIPE_WEBHOOK_SECRET=whsec_... # from Stripe → Webhooks → signing secret
# Subscription plan price IDs from Stripe dashboard:
STRIPE_PRICE_STARTER=price_...  # e.g. $47/mo
STRIPE_PRICE_PRO=price_...      # e.g. $97/mo
STRIPE_PRICE_AGENCY=price_...   # e.g. $197/mo

# ── Email Reminders (SMTP) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@plexautomation.io
SMTP_PASS=your-app-password
SMTP_FROM=PLEX Automation <hello@plexautomation.io>

# ── App ───────────────────────────────────────────────────────────
APP_URL=https://app.plexautomation.io
PORT=4173                       # Railway sets this automatically

PLEX_OWNER_EMAIL=guffey.ryan@gmail.com  # Only this user sees plex-master account
